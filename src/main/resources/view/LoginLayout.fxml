                        <Font size="14.0" />
                     </font>
                  </TextField>
               </children>
            </HBox>
            <HBox layoutX="10.0" layoutY="10.0" prefHeight="38.0" prefWidth="242.0">
               <children>
                  <Label prefHeight="38.0" prefWidth="86.0" text="Password">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
                  <Pane prefHeight="38.0" prefWidth="16.0" />
                  <PasswordField fx:id="passLogin" prefHeight="39.0" prefWidth="146.0" promptText="password" style="-fx-background-color: transparent; -fx-border-color: C9A0DC; -fx-border-width: 0px 0px 2px 0px;" />
               </children>
            </HBox>
         </children>
      </VBox>
      <AnchorPane layoutX="-8.0" prefHeight="720.0" prefWidth="402.0" style="-fx-background-color: CDC1FF;">
         <children>
            <ImageView fitHeight="228.0" fitWidth="228.0" layoutX="94.0" layoutY="162.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/vecteezy_german-chocolate-cake-with_25268608.png" />
               </image>
            </ImageView>
            <Label alignment="CENTER" layoutX="87.0" layoutY="14.0" prefHeight="86.0" prefWidth="242.0" text="Cakelogy Deligts">
               <font>
                  <Font name="Monotype Corsiva" size="30.0" />
               </font>
            </Label>
            <ImageView fitHeight="133.0" fitWidth="144.0" layoutX="221.0" layoutY="465.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/cupcakes%20(1).png" />
               </image>
            </ImageView>
            <ImageView fitHeight="96.0" fitWidth="129.0" layoutX="30.0" layoutY="385.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/cupcakes%20(2).png" />
