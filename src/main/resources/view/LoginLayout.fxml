<AnchorPane fx:id="loginContent" prefHeight="720.0" prefWidth="960.0" style="-fx-background-color: FFF6E3;" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.gdse.professionalsoftwareproject.controller.LoginController">
   <children>
      <Label alignment="CENTER" layoutX="609.0" layoutY="105.0" prefHeight="47.0" prefWidth="129.0" text="Login Page">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="btnLogin" layoutX="688.0" layoutY="300.0" mnemonicParsing="false" onAction="#loginOnAction" prefHeight="31.0" prefWidth="101.0" style="-fx-background-color: D0E8C5; -fx-background-radius: 10;" stylesheets="@../cssStyles/Button.css" text="Login">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <VBox layoutX="532.0" layoutY="188.0" prefHeight="77.0" prefWidth="242.0">
         <children>
            <HBox prefHeight="38.0" prefWidth="242.0">
               <children>
                  <Label prefHeight="38.0" prefWidth="86.0" text="User ID">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
                  <Pane prefHeight="38.0" prefWidth="16.0" />
                  <TextField fx:id="lblUserName" prefHeight="40.0" prefWidth="146.0" promptText="username" style="-fx-background-color: transparent; -fx-border-color: #C8A1E0; -fx-border-width: 0px 0px 2px 0px;">
