                  <Pane prefHeight="30.0" prefWidth="17.0" />
                  <TextField fx:id="txtAmountSpent" prefHeight="38.0" prefWidth="242.0" promptText="amount Of Spent" style="-fx-background-color: transparent; -fx-border-color: pink; -fx-border-width: 0px 0px 2px 0px;" />
